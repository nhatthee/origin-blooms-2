# Shown on the shared purple footer "Request a quote" mailto button (optional).
NEXT_PUBLIC_CONTACT_EMAIL=sales@originblooms.com

# Public site origin used for absolute asset URLs in emails (e.g. logo).
# Defaults to https://originblooms.com if unset. Do not use localhost.
# NEXT_PUBLIC_SITE_URL=https://originblooms.com

# Resend API key for the /contact form (server-only — never use NEXT_PUBLIC_*).
# Create at https://resend.com — required to send inquiry emails with Excel attachments.
RESEND_API_KEY=

# Verified sender address in Resend (e.g. Origin Blooms <inquiries@your-domain.com>).
# Must be a domain/address verified in the Resend dashboard. Used as the email From.
CONTACT_FROM_EMAIL=

# Inbox that receives inquiries (defaults to sales@originblooms.com if unset).
# Reply-To is set to the customer's email so you can reply directly.
CONTACT_TO_EMAIL=sales@originblooms.com
